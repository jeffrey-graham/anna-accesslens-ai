{
  "schema": 4,
  "required_executas": [],
  "optional_executas": [],
  "system_prompt_addendum": "When the user mentions AccessLens AI to simplify dense medical, legal, financial, or technical text, extract action checklists or red-flag risks, open a dyslexia-friendly Bionic reading studio, audit/repair inaccessible HTML, narrate text aloud, or visualize a concept map, summon the interactive studio via open_app_view using this app's numeric app_id. Pass view ('main', 'checklist', 'dyslexia_studio', 'html_repair', 'narration', or 'concept_map') and payload ({'title': '...', 'text': '...', 'html': '...', 'domain': 'medical|legal|financial|technical', 'reading_level': 'grade5|consumer|executive'}).",
  "tags": [
    "accessibility",
    "plain-language",
    "wcag-2-2",
    "dyslexia",
    "document-clarity",
    "concept-map",
    "narration"
  ],
